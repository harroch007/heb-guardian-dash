import { useEffect } from 'react';
import { Link, useNavigate } from 'react-router-dom';
import { ArrowLeft, ArrowUpLeft, Check, MessageCircle, Plus } from 'lucide-react';
import { useAuth } from '@/contexts/AuthContext';
import { useWaitlist } from '@/contexts/WaitlistContext';
import { KippyLogo } from '@/components/brand/KippyLogo';
import { ParentMoments } from '@/components/brand/ParentMoments';
import { CookieConsent } from '@/components/landing/CookieConsent';
import '@/styles/kippy-landing.css';

const questions = [
  { question: 'למי Kippy מיועדת?', answer: 'להורים לילדים מהטלפון הראשון ועד גיל 13 או 14. מתחילים בעברית, למשפחות בישראל, עם אפליקציה למכשיר Android של הילד וממשק להורה.' },
  { question: 'אפשר כבר להתחיל להשתמש?', answer: 'אנחנו בונים את Kippy לקראת השקה. כרגע אפשר להצטרף לעדכונים על ההתקדמות ועל הזדמנויות עתידיות לפיילוט. ההצטרפות אינה פתיחת חשבון ואינה מבטיחה הזמנה או מועד פתיחה.' },
  { question: 'מה ההורה אמור לראות?', answer: 'אנחנו מתכננים לרכז להורה את מצב המכשיר, גבולות השימוש ואירועים שדורשים תשומת לב, לצד הכוונה לשיחה. המטרה היא לתת מידע מועיל תוך כבוד לפרטיות הילד. לפני פתיחת הגישה נסביר במדויק מה ההורה רואה ואיך המידע מטופל.' },
  { question: 'ומה אם זו רק בדיחה בין חברים?', answer: 'זו בדיוק הסיבה שחשוב להבין את ההקשר ולשמוע את הילד. התראה אמורה לעזור להתחיל בירור. הטכנולוגיה אינה מכירה את הילד כמוכם, והיא יכולה לטעות.' },
  { question: 'איפה Kippy מתוכננת לעזור?', answer: 'הגרסה הראשונה מתמקדת בגבולות לשימוש בטלפון, בטיחות ב־WhatsApp והכוונה להורים. ניתוח הודעות קוליות הוא השלב הבא בעבודה, מיד אחרי השלמת הגרסה הראשונה. בהמשך מתוכננת הרחבה ל־Instagram, TikTok, Roblox ומקומות נוספים שבהם ילדים מתקשרים. נעדכן בכל פעם שיכולת תהיה זמינה.' },
  { question: 'יהיו גם שפות נוספות?', answer: 'כן, בתכנון. מתחילים בעברית בישראל, ובהמשך נוסיף רוסית, אנגלית וערבית כדי להגיע למשפחות נוספות בארץ.' },
];

export default function LandingV1() {
  const { user, loading } = useAuth();
  const { openModal } = useWaitlist();
  const navigate = useNavigate();
  useEffect(() => { if (!loading && user) navigate('/home-v2', { replace: true }); }, [user, loading, navigate]);
  if (loading || user) return null;
  return (
    <div className="kippy-site" dir="rtl">
      <header className="kippy-header"><div className="kippy-wrap kippy-nav">
        <Link to="/" aria-label="Kippy לעמוד הבית"><KippyLogo className="kippy-nav-logo" /></Link>
        <nav aria-label="ניווט ראשי"><a href="#benefits">מה יוצא לכם מזה</a><a href="#trust">אפשר לסמוך</a><a href="#faq">שאלות של הורים</a></nav>
        <button onClick={openModal} className="kippy-button kippy-button-small">מצטרפים לעדכונים<ArrowLeft aria-hidden="true" size={17} /></button>
      </div></header>
      <main id="main-content">
        <section className="kippy-hero kippy-wrap" aria-labelledby="hero-title">
          <div className="kippy-hero-copy">
            <p className="kippy-eyebrow"><span aria-hidden="true" />מהטלפון הראשון. יחד איתכם.</p>
            <h1 id="hero-title">הטלפון אצלם.<br /><span>אתם בתמונה.</span></h1>
            <p className="kippy-hero-lead">לדעת מתי הילד צריך אתכם.<br />ולהבין איך לעזור.</p>
            <p className="kippy-hero-description">בשביל זה אנחנו בונים את Kippy. יותר ביטחון לכם, יותר מקום לגדול להם.</p>
            <div className="kippy-hero-actions"><button className="kippy-button" onClick={openModal}>מצטרפים לעדכונים<ArrowLeft aria-hidden="true" size={20} /></button><a className="kippy-text-link" href="#benefits">מכירים את Kippy<ArrowUpLeft aria-hidden="true" size={19} /></a></div>
            <p className="kippy-availability">לקראת השקה בישראל. נעדכן כשאפשר להצטרף.</p>
          </div>
          <figure className="kippy-hero-art"><img className="kippy-family-art" src="/brand/kippy-together.webp" width="1254" height="1254" alt="איור נייר של הורה וילד בשיחה, מחוברים בקשת כתומה פתוחה" /><figcaption>לתת להם לגדול. להישאר קרובים.</figcaption></figure>
        </section>
        <div className="kippy-intro-strip"><div className="kippy-wrap"><span>נבנית למשפחות בישראל</span><span>מהטלפון הראשון ועד גיל 13 או 14</span><span>מתחילים בעברית</span></div></div>
        <ParentMoments />
        <section className="kippy-conversation-section" id="conversation"><div className="kippy-wrap kippy-conversation-grid">
          <div className="kippy-conversation-paper"><span className="kippy-paper-label">לפעמים, הכול מתחיל במשפט אחד</span><p>״איך אתה מרגיש<br />בקבוצה בזמן האחרון?״</p><div className="kippy-paper-rule" /><span>קודם מקשיבים. אחר כך מבינים יחד.</span><MessageCircle aria-hidden="true" className="kippy-paper-icon" size={58} strokeWidth={1.3} /></div>
          <div className="kippy-conversation-copy"><p className="kippy-eyebrow">אתם מכירים אותם הכי טוב</p><h2>להיות קרובים.<br />גם לעולם שלהם.</h2><p>לא תמיד קל לדעת מה לשאול. לפעמים צריך רק כיוון קטן שיעזור לפתוח שיחה טובה.</p><p>הכוונה להורה היא חלק מרכזי ממה שאנחנו בונים. כי בסוף, מה שחשוב הוא הקשר ביניכם.</p><a href="#trust" className="kippy-text-link">מה חשוב לנו בדרך<ArrowLeft aria-hidden="true" size={19} /></a></div>
        </div></section>
        <section id="trust" className="kippy-section kippy-wrap kippy-trust-grid"><div><p className="kippy-eyebrow">האמון שלכם הוא הבסיס</p><h2>הילד שלכם.<br />האחריות שלנו<br />להיות ברורים.</h2><p className="kippy-trust-intro">אלה העקרונות שמנחים אותנו בבנייה של Kippy.</p><KippyLogo className="kippy-trust-mark" markOnly /></div><div className="kippy-trust-list">
          <article><span>01</span><div><h3>ברור מה רואים ומה נשמר</h3><p>לפני פתיחת הגישה נסביר בשפה פשוטה איזה מידע מעובד, מה מגיע להורה ואילו אפשרויות מחיקה קיימות.</p></div></article>
          <article><span>02</span><div><h3>מקום גם לחוסר ודאות</h3><p>התראה היא סיבה לבדוק ולהקשיב. הטכנולוגיה יכולה לטעות, וההיכרות שלכם עם הילד נשארת במרכז.</p></div></article>
          <article><span>03</span><div><h3>כל הבטחה צריכה להיות ברורה</h3><p>נסביר מה פתוח לשימוש ומה עדיין בתכנון. מתחילים בעברית בישראל, עם גבולות לשימוש בטלפון ובטיחות ב־WhatsApp.</p></div></article>
        </div></section>
        <section id="faq" className="kippy-faq-section"><div className="kippy-wrap kippy-faq-grid"><div><p className="kippy-eyebrow">טוב ששאלתם</p><h2>השאלות<br />שגם לנו<br />חשוב לענות עליהן.</h2><p>משהו נשאר פתוח?</p><a className="kippy-text-link" href="mailto:support@kippyai.com">אפשר לכתוב לנו<ArrowUpLeft aria-hidden="true" size={18} /></a></div><div className="kippy-faq-list">{questions.map(({ question, answer }) => <details key={question}><summary>{question}<Plus aria-hidden="true" size={22} /></summary><p>{answer}</p></details>)}</div></div></section>
        <section className="kippy-wrap kippy-final-section"><div className="kippy-final-cta"><div><p className="kippy-eyebrow">הטלפון הראשון הוא רק ההתחלה</p><h2>נעים לגדול.<br />טוב שיש עם מי.</h2><p>הצטרפו לעדכונים ונשתף אתכם בדרך של Kippy להשקה.</p></div><div className="kippy-final-action"><button className="kippy-button" onClick={openModal}>מצטרפים לעדכונים<ArrowLeft aria-hidden="true" size={20} /></button><span><Check aria-hidden="true" size={16} />עדכונים על Kippy לקראת ההשקה</span></div><div className="kippy-cta-loop" aria-hidden="true" /></div></section>
      </main>
      <footer className="kippy-footer"><div className="kippy-wrap"><div className="kippy-footer-top"><Link to="/" aria-label="Kippy לעמוד הבית"><KippyLogo className="kippy-footer-logo" /></Link><p>יותר שקט לכם. יותר מקום לגדול להם.</p><a href="mailto:support@kippyai.com">support@kippyai.com</a></div><div className="kippy-footer-bottom"><span>© {new Date().getFullYear()} Kippy. כל הזכויות שמורות.</span><nav aria-label="מידע נוסף"><Link to="/privacy">מדיניות פרטיות</Link><Link to="/terms">תנאי שימוש</Link><a href="#main-content">בחזרה למעלה</a></nav></div></div></footer>
      <CookieConsent />
    </div>
  );
}
