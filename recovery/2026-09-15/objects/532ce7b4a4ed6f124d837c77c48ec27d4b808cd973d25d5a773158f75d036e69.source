import { normalizeIncidentClaim } from "./incident_claim.ts";
import {
  IncidentCryptoError,
  validateSubmittedEnvelope,
} from "./incident_crypto.ts";
import {
  EPHEMERAL_PRIVACY_CONTRACT_VERSION,
  isStoredIncidentPrivacyContractVersion,
  isSupportedIncidentPrivacyContractVersion,
  LEGACY_STORED_PRIVACY_CONTRACT_VERSION,
  STORED_SAFETY_CONTEXT_PRIVACY_CONTRACT_VERSION,
} from "./incident_submission.ts";

const ALGORITHM = "RSA-OAEP-3072-SHA256+AES-256-GCM";

Deno.test("stored claim boundary accepts V1/V2 and rejects ephemeral V3", () => {
  for (
    const version of [
      LEGACY_STORED_PRIVACY_CONTRACT_VERSION,
      STORED_SAFETY_CONTEXT_PRIVACY_CONTRACT_VERSION,
    ] as const
  ) {
    assert(isStoredIncidentPrivacyContractVersion(version));
    assertEquals(
      normalizeIncidentClaim(storedClaim(version)).privacy_contract_version,
      version,
    );
  }

  assert(
    !isStoredIncidentPrivacyContractVersion(EPHEMERAL_PRIVACY_CONTRACT_VERSION),
  );
  assertThrows(() =>
    normalizeIncidentClaim(storedClaim(EPHEMERAL_PRIVACY_CONTRACT_VERSION))
  );
});

Deno.test("crypto envelope boundary accepts V1/V2/V3 and rejects unknown versions", () => {
  for (
    const version of [
      LEGACY_STORED_PRIVACY_CONTRACT_VERSION,
      STORED_SAFETY_CONTEXT_PRIVACY_CONTRACT_VERSION,
      EPHEMERAL_PRIVACY_CONTRACT_VERSION,
    ] as const
  ) {
    assert(isSupportedIncidentPrivacyContractVersion(version));
    validateSubmittedEnvelope(envelope(version), {
      aadVersion: 3,
      privacyContractVersion: version,
      privacyIdentityVersion: 7,
      keyVersion: 1,
      algorithm: ALGORITHM,
    });
  }

  assert(!isSupportedIncidentPrivacyContractVersion(4));
  assertThrowsCrypto(
    () =>
      validateSubmittedEnvelope(envelope(4), {
        aadVersion: 3,
        privacyContractVersion: 4,
        privacyIdentityVersion: 7,
        keyVersion: 1,
        algorithm: ALGORITHM,
      }),
    "incident_envelope_header_mismatch",
  );
});

function storedClaim(privacyContractVersion: number): Record<string, unknown> {
  return {
    incident_id: "11111111-1111-4111-8111-111111111111",
    lease_token: "a".repeat(64),
    client_incident_id: "22222222-2222-4222-8222-222222222222",
    device_id: "33333333-3333-4333-8333-333333333333",
    child_id: "44444444-4444-4444-8444-444444444444",
    category: "bullying",
    severity: "high",
    child_role: "target",
    confidence_canonical: "0.900000",
    capture_quality_canonical: "0.800000",
    occurred_at_canonical: "2026-08-30T00:00:00.000Z",
    lease_expires_at_canonical: "2026-08-30T00:02:00.000Z",
    context_expires_at_canonical: "2026-08-31T00:00:00.000Z",
    model_contract_version: 2,
    privacy_contract_version: privacyContractVersion,
    privacy_identity_version: 7,
    aad_version: 3,
    encryption_algorithm: ALGORITHM,
    key_version: 1,
    message_count: 2,
    encrypted_payload_base64: "opaque",
  };
}

function envelope(privacyContractVersion: number): string {
  const bytes = new TextEncoder().encode(JSON.stringify({
    envelope_version: 2,
    aad_version: 3,
    privacy_contract_version: privacyContractVersion,
    privacy_identity_version: 7,
    key_version: 1,
    algorithm: ALGORITHM,
    nonce_base64: base64(new Uint8Array(12)),
    wrapped_key_base64: base64(new Uint8Array(384)),
    ciphertext_base64: base64(new Uint8Array(17)),
  }));
  try {
    return base64(bytes);
  } finally {
    bytes.fill(0);
  }
}

function base64(bytes: Uint8Array): string {
  let binary = "";
  for (const byte of bytes) binary += String.fromCharCode(byte);
  return btoa(binary);
}

function assert(value: boolean): void {
  if (!value) throw new Error("assertion_failed");
}

function assertEquals(actual: unknown, expected: unknown): void {
  if (actual !== expected) {
    throw new Error(`expected=${String(expected)} actual=${String(actual)}`);
  }
}

function assertThrows(action: () => unknown): void {
  try {
    action();
  } catch {
    return;
  }
  throw new Error("expected_rejection");
}

function assertThrowsCrypto(action: () => unknown, expectedCode: string): void {
  try {
    action();
  } catch (error) {
    if (error instanceof IncidentCryptoError && error.code === expectedCode) {
      return;
    }
    throw error;
  }
  throw new Error("expected_crypto_rejection");
}
