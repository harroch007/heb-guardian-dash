:root { --kippy-blue: #183d94; --kippy-ink: #183052; --kippy-orange: #ff8c42; --kippy-paper: #fcf9f3; }
.kippy-site { background: var(--kippy-paper); color: var(--kippy-ink); overflow: clip; font-family: Fredoka, Arial, sans-serif; font-weight: 400; }
.kippy-wrap { width: min(1260px, calc(100% - 40px)); margin-inline: auto; }
.kippy-header { position: sticky; top: 0; z-index: 40; background: var(--kippy-paper); border-bottom: 1px solid #183d940f; }
.kippy-nav { min-height: 77px; display: flex; align-items: center; justify-content: space-between; gap: 18px; }
.kippy-nav-logo { width: 106px; height: auto; }
.kippy-nav nav { display: none; }
.kippy-button { display: inline-flex; gap: 17px; align-items: center; justify-content: center; min-height: 55px; padding: 14px 22px; border: 2px solid transparent; border-radius: 16px; background: var(--kippy-blue); color: #fff; font: 500 1.0625rem Fredoka, Arial, sans-serif; cursor: pointer; transition: background-color 160ms, transform 160ms; }
.kippy-button:hover { background: #0e2c72; transform: translateY(-2px); }
.kippy-button-small { min-height: 44px; font-size: 0.875rem; padding: 9px 13px; gap: 9px; border-radius: 13px; }
.kippy-site :is(a, button, summary, [tabindex]):focus-visible { outline: 3px solid var(--kippy-blue); outline-offset: 5px; }
.kippy-site section[id] { scroll-margin-top: 100px; }
.kippy-eyebrow { color: var(--kippy-blue); font-size: 0.875rem; font-weight: 500; margin-bottom: 20px; }
.kippy-hero { display: grid; padding-block: 39px 0; gap: 7px; }
.kippy-hero .kippy-eyebrow { display: flex; align-items: center; gap: 10px; }
.kippy-hero .kippy-eyebrow > span { width: 7px; height: 7px; border-radius: 50%; background: var(--kippy-orange); }
.kippy-hero h1 { font-size: clamp(2.7rem, 11.6vw, 4.8rem); font-weight: 580; line-height: 1.14; letter-spacing: -.035em; color: var(--kippy-blue); margin-bottom: 23px; }
.kippy-hero h1 > span { position: relative; isolation: isolate; }
.kippy-hero h1 > span::after { content: ''; position: absolute; inset-inline: -2px; bottom: 2px; height: 12px; background: #ffc694; z-index: -1; border-radius: 50%; transform: rotate(-2deg); }
.kippy-hero-lead { font-size: 1.5rem; line-height: 1.45; font-weight: 450; margin-bottom: 15px; }
.kippy-hero-description { max-width: 385px; color: #56637a; font-size: 1.0625rem; line-height: 1.7; margin-bottom: 25px; }
.kippy-hero-actions { display: flex; gap: 17px; align-items: center; flex-wrap: wrap; }
.kippy-text-link { display: inline-flex; align-items: center; gap: 8px; color: var(--kippy-blue); font-size: 1rem; font-weight: 500; min-height: 44px; text-underline-offset: 6px; }
.kippy-text-link:hover { text-decoration: underline; }
.kippy-availability { color: #617087; font-size: 0.8125rem; margin-top: 14px; }
.kippy-hero-art { position: relative; min-width: 0; width: calc(100% + 40px); margin-inline: -20px; align-self: center; }
.kippy-family-art { width: 100%; height: auto; mix-blend-mode: multiply; }
.kippy-hero-art figcaption { position: absolute; bottom: 1%; inset-inline: 0; text-align: center; font-size: 0.8125rem; color: #536784; }
.kippy-intro-strip { border-block: 1px solid #183d941c; padding-block: 18px; margin-top: 25px; }
.kippy-intro-strip > div { display: flex; align-items: center; justify-content: center; flex-wrap: wrap; gap: 9px 18px; }
.kippy-intro-strip span { color: #54647e; font-size: 0.8125rem; }
.kippy-intro-strip span:first-child { color: var(--kippy-blue); font-weight: 500; }
.kippy-section { padding-block: 68px; }
.kippy-site h2 { font-size: clamp(2.25rem, 9.4vw, 3.8rem); font-weight: 520; color: var(--kippy-blue); line-height: 1.15; letter-spacing: -.024em; }
.kippy-moments { padding-block: 65px; background: #fff; }
.kippy-moments-heading > p:last-child { margin-top: 21px; color: #53647a; font-size: 1.0625rem; line-height: 1.7; }
.kippy-moment-tabs { display: grid; grid-template-columns: repeat(3, 1fr); gap: 5px; border-bottom: 1px solid #ccd6e9; margin-top: 32px; }
.kippy-moment-tabs button { position: relative; min-height: 73px; padding: 14px 7px; display: flex; align-items: center; justify-content: center; gap: 9px; font-size: 0.9375rem; line-height: 1.4; color: #62718a; border-bottom: 3px solid transparent; transition: color 160ms, background-color 160ms, border-color 160ms; }
.kippy-moment-tabs button[aria-selected='true'] { color: var(--kippy-blue); border-bottom-color: var(--kippy-orange); background: #fff7ef; font-weight: 500; border-radius: 10px 10px 0 0; }
.kippy-moment-tabs button:hover { background: #fff7ef; }
.kippy-moment-tabs svg, .kippy-tab-number { display: none; }
.kippy-moment-panel { display: grid; gap: 33px; padding-top: 35px; }
.kippy-moment-explanation { grid-row: 1; }
.kippy-moment-explanation h3 { font-size: 1.75rem; font-weight: 500; line-height: 1.25; margin-bottom: 17px; color: var(--kippy-blue); }
.kippy-moment-explanation > p:not(.kippy-eyebrow) { color: #53647a; font-size: 1.125rem; line-height: 1.8; }
.kippy-concept-label { display: block; color: #6a7588; font-size: 0.75rem; margin-top: 18px; }
.kippy-moment-note { background: #f2f5fc; border-radius: 32px 10px 32px 10px; min-height: 297px; padding: 26px; position: relative; border: 1px solid #e0e7f5; box-shadow: 7px 9px 0 #eaf0fc; margin-inline-end: 8px; }
.kippy-moment-note-icon { display: inline-flex; background: #fff; padding: 12px; border-radius: 50%; color: var(--kippy-blue); }
.kippy-moment-note > p { color: var(--kippy-blue); font-size: 1.625rem; line-height: 1.4; margin-block: 20px 28px; }
.kippy-moment-note strong { font-weight: 500; }
.kippy-moment-note > span:last-of-type { color: #526581; font-size: 0.8125rem; position: relative; z-index: 1; }
.kippy-pencil { display: block; width: 85%; height: 32px; margin-top: 10px; }
.kippy-pencil path { fill: none; stroke: #ff8c42; stroke-width: 3; stroke-linecap: round; }
.kippy-everyday { display: grid; gap: 10px; border-top: 1px solid #e3e8f1; padding-top: 27px; margin-top: 45px; }
.kippy-everyday strong { color: var(--kippy-blue); font-size: 1.1875rem; font-weight: 500; }
.kippy-everyday p { font-size: 1rem; color: #5b6a80; line-height: 1.8; max-width: 590px; }
.kippy-conversation-section { background: var(--kippy-blue); padding-block: 66px 80px; position: relative; isolation: isolate; overflow: hidden; }
.kippy-conversation-section::before { content: ''; position: absolute; width: 450px; height: 700px; border: 1px solid #ffffff13; border-radius: 50%; inset-inline-start: -180px; top: -180px; transform: rotate(38deg); z-index: -1; }
.kippy-conversation-grid { display: grid; gap: 46px; align-items: center; }
.kippy-conversation-copy { color: #fff; grid-row: 1; }
.kippy-conversation-copy h2 { color: #fff; }
.kippy-conversation-copy .kippy-eyebrow { color: #ffd2aa; }
.kippy-conversation-copy > p:not(.kippy-eyebrow) { font-size: 1.125rem; line-height: 1.8; color: #e5edff; margin-top: 23px; max-width: 470px; }
.kippy-conversation-copy .kippy-text-link { color: #fff; margin-top: 25px; }
.kippy-conversation-copy a:focus-visible { outline-color: #fff; }
.kippy-conversation-paper { position: relative; padding: 29px 24px 40px; background: #fff7ed; border-radius: 13px; color: var(--kippy-blue); transform: rotate(3deg); box-shadow: 10px 12px 0 #ff8c42, 20px 29px 28px #091c4826; margin-inline: 5px 15px; }
.kippy-paper-label { font-size: 0.8125rem; color: #5d6d88; }
.kippy-conversation-paper > p { font-size: clamp(1.35rem, 6.25vw, 2.8rem); font-weight: 500; line-height: 1.4; margin-block: 29px; }
.kippy-paper-rule { height: 1px; background: #dcdedb; margin-bottom: 22px; }
.kippy-conversation-paper > span:last-of-type { font-size: 0.9375rem; }
.kippy-paper-icon { position: absolute; bottom: -23px; inset-inline-end: 27px; color: #ffb47d; fill: #183d94; transform: rotate(-8deg); }
.kippy-trust-grid { display: grid; gap: 33px; }
.kippy-trust-intro { color: #53647a; margin-top: 24px; font-size: 1.125rem; max-width: 340px; line-height: 1.7; }
.kippy-trust-mark { display: none; }
.kippy-trust-list article { display: flex; gap: 18px; padding-block: 25px; border-bottom: 1px solid #dfe3e9; }
.kippy-trust-list article > span { flex-shrink: 0; font-size: 0.875rem; padding-top: 7px; color: #aa4e17; }
.kippy-trust-list h3 { color: var(--kippy-blue); font-size: 1.5625rem; line-height: 1.25; font-weight: 500; margin: 3px 0 14px; }
.kippy-trust-list p { color: #586a81; font-size: 1.0625rem; line-height: 1.8; }
.kippy-faq-section { background: #eef3fc; padding-block: 62px; }
.kippy-faq-grid { display: grid; gap: 33px; }
.kippy-faq-grid > div > p:not(.kippy-eyebrow) { margin-top: 24px; color: #53647a; font-size: 1.0625rem; }
.kippy-faq-list details { border-bottom: 1px solid #cdd8eb; padding-block: 22px; }
.kippy-faq-list details:first-child { padding-top: 0; }
.kippy-faq-list summary { display: flex; align-items: center; justify-content: space-between; gap: 20px; cursor: pointer; list-style: none; color: var(--kippy-blue); font-size: 1.25rem; line-height: 1.45; min-height: 44px; }
.kippy-faq-list summary::-webkit-details-marker { display: none; }
.kippy-faq-list summary > svg { flex-shrink: 0; transition: transform 180ms; }
.kippy-faq-list details[open] summary > svg { transform: rotate(45deg); }
.kippy-faq-list details > p { font-size: 1.0625rem; line-height: 1.8; margin-block: 16px 5px; color: #4d607c; max-width: 560px; }
.kippy-final-section { padding-block: 55px; }
.kippy-final-cta { position: relative; overflow: hidden; isolation: isolate; background: #ffdec3; padding: 34px 25px; border-radius: 28px 8px 28px 8px; display: flex; flex-direction: column; align-items: start; gap: 28px; }
.kippy-final-cta .kippy-eyebrow { color: #684121; }
.kippy-final-cta p:not(.kippy-eyebrow) { margin-top: 21px; font-size: 1.125rem; max-width: 460px; line-height: 1.6; }
.kippy-final-action { width: 100%; }
.kippy-final-action > .kippy-button { width: 100%; }
.kippy-final-action > span { display: flex; gap: 6px; align-items: center; justify-content: center; font-size: 0.8125rem; margin-top: 17px; color: #5e472f; }
.kippy-cta-loop { position: absolute; width: 300px; height: 440px; inset-inline-end: -85px; top: -70px; border: 42px solid #ffd0a9; border-radius: 50%; transform: rotate(30deg); z-index: -1; }
.kippy-footer { padding-block: 0 30px; }
.kippy-footer-top { display: flex; flex-direction: column; align-items: start; gap: 17px; padding-bottom: 28px; }
.kippy-footer-logo { width: 128px; height: auto; }
.kippy-footer-top > p { color: #526682; font-size: 1.0625rem; }
.kippy-footer-top > a { color: var(--kippy-blue); direction: ltr; font-size: 1rem; }
.kippy-footer-bottom { display: flex; flex-direction: column; gap: 20px; padding-top: 25px; border-top: 1px solid #e0e4eb; color: #62728a; font-size: 0.8125rem; }
.kippy-footer-bottom nav { display: flex; flex-wrap: wrap; gap: 18px; }
.kippy-footer a:hover { text-decoration: underline; text-underline-offset: 5px; }
@media (min-width: 720px) {
  .kippy-wrap { width: min(1260px, calc(100% - 64px)); }
  .kippy-nav { min-height: 94px; }.kippy-nav-logo { width: 126px; }
  .kippy-nav nav { display: flex; gap: 25px; font-size: 1rem; }.kippy-nav nav a { padding-block: 14px; }
  .kippy-button-small { font-size: 1rem; padding: 11px 18px; }
  .kippy-hero { grid-template-columns: 1fr 1fr; align-items: center; gap: 15px; padding-block: 60px 45px; min-height: 635px; }
  .kippy-hero h1 { font-size: clamp(3.1rem, 5.5vw, 5.1rem); }.kippy-hero-lead { font-size: 1.6875rem; }
  .kippy-hero-art { width: calc(100% + 20px); margin-inline: -10px; }
  .kippy-hero-art figcaption { font-size: 0.875rem; }
  .kippy-intro-strip { margin-top: 0; padding-block: 22px; }.kippy-intro-strip > div { justify-content: space-between; }.kippy-intro-strip span { font-size: 0.9375rem; }
  .kippy-section, .kippy-moments { padding-block: 94px; }
  .kippy-site h2 { font-size: clamp(2.6rem, 4.2vw, 4rem); }
  .kippy-moment-tabs { margin-top: 43px; gap: 18px; }.kippy-moment-tabs button { justify-content: start; font-size: 1.25rem; padding: 20px; gap: 18px; }.kippy-tab-number { display: inline; font-size: 0.8125rem; }.kippy-moment-tabs svg { display: block; margin-inline-start: auto; }
  .kippy-moment-panel { grid-template-columns: 1.1fr 1fr; align-items: center; gap: 65px; padding-top: 44px; min-height: 425px; }.kippy-moment-explanation { grid-row: auto; }
  .kippy-moment-note { min-height: 325px; padding: 32px; }.kippy-moment-note > p { font-size: 1.9375rem; }.kippy-moment-note > span:last-of-type { font-size: 0.9375rem; }
  .kippy-moment-explanation h3 { font-size: 2.25rem; }.kippy-moment-explanation > p:not(.kippy-eyebrow) { font-size: 1.1875rem; }
  .kippy-everyday { display: flex; align-items: center; justify-content: space-between; gap: 35px; margin-top: 50px; }.kippy-everyday strong { font-size: 1.3125rem; }
  .kippy-conversation-section { padding-block: 98px; }.kippy-conversation-grid { grid-template-columns: 1fr 1fr; gap: 75px; }.kippy-conversation-copy { grid-row: auto; }.kippy-conversation-paper { padding: 36px 33px 56px; }.kippy-paper-label { font-size: 0.9375rem; }.kippy-conversation-paper > p { font-size: 2.125rem; }.kippy-conversation-copy > p:not(.kippy-eyebrow) { font-size: 1.1875rem; }
  .kippy-trust-grid { grid-template-columns: 1fr 1fr; gap: 80px; }.kippy-trust-mark { display: block; width: 93px; height: 93px; margin-top: 34px; }.kippy-trust-list article:first-child { padding-top: 0; }.kippy-trust-list h3 { font-size: 1.6875rem; }.kippy-trust-list p { font-size: 1.125rem; }
  .kippy-faq-section { padding-block: 90px; }.kippy-faq-grid { grid-template-columns: 1fr 1.25fr; gap: 80px; }.kippy-faq-list summary { font-size: 1.375rem; }.kippy-faq-list details > p { font-size: 1.125rem; }
  .kippy-final-section { padding-block: 85px; }.kippy-final-cta { padding: 55px; flex-direction: row; justify-content: space-between; align-items: center; gap: 40px; }.kippy-final-action { width: auto; flex-shrink: 0; }
  .kippy-footer-top { flex-direction: row; align-items: center; justify-content: space-between; }.kippy-footer-bottom { flex-direction: row; justify-content: space-between; align-items: center; font-size: 0.875rem; }
}
@media (min-width: 1100px) {
  .kippy-wrap { width: min(1260px, calc(100% - 112px)); }.kippy-hero { min-height: 735px; grid-template-columns: .95fr 1.05fr; padding-block: 50px; }.kippy-hero h1 { font-size: 4.875rem; }.kippy-hero-lead { font-size: 1.875rem; }.kippy-hero-description { font-size: 1.1875rem; }.kippy-hero-art { width: calc(100% + 40px); margin-inline: -20px; }.kippy-eyebrow { font-size: 0.9375rem; }.kippy-hero-actions { gap: 25px; }.kippy-button { font-size: 1.125rem; }.kippy-button-small { font-size: 1rem; }.kippy-moment-note { padding: 40px; }.kippy-moment-note > p { font-size: 2.25rem; }.kippy-conversation-paper > p { font-size: 2.5rem; }
}
@media (prefers-reduced-motion: reduce) { .kippy-site *, .kippy-site *::before, .kippy-site *::after { transition: none !important; animation: none !important; scroll-behavior: auto !important; } }
.reduce-motion .kippy-site *, .reduce-motion .kippy-site *::before, .reduce-motion .kippy-site *::after { transition: none !important; animation: none !important; scroll-behavior: auto !important; }
.high-contrast .kippy-site { --kippy-blue: #ff0; --kippy-ink: #fff; --kippy-paper: #000; background: #000; color: #fff; }
.high-contrast .kippy-site :is(header, section, footer, article, details, .kippy-intro-strip, .kippy-final-cta, .kippy-conversation-paper, .kippy-moment-note) { background: #000 !important; color: #fff !important; border-color: #fff; }
.high-contrast .kippy-site :is(p, span, h1, h2, h3, a, summary, figcaption) { color: inherit !important; }.high-contrast .kippy-button { background: #ff0; color: #000; }.high-contrast .kippy-hero h1 > span::after { display: none; }.high-contrast .kippy-family-art { mix-blend-mode: normal; }.high-contrast .kippy-moment-tabs button[aria-selected='true'] { color: #000; }

/* Honor the existing text-size control without compressing the text. */
.kippy-nav > a { flex-shrink: 0; }
.kippy-button-small { min-width: 0; text-align: center; }
@media (max-width: 1099px) {
  html:is(.accessibility-text-1, .accessibility-text-2, .accessibility-text-3, .accessibility-text-4) .kippy-nav nav { display: none; }
}
@media (max-width: 719px) {
  html:is(.accessibility-text-2, .accessibility-text-3, .accessibility-text-4) .kippy-nav-logo { width: 80px; }
  html:is(.accessibility-text-2, .accessibility-text-3, .accessibility-text-4) .kippy-nav { gap: 10px; }
  html:is(.accessibility-text-3, .accessibility-text-4) .kippy-moment-tabs { grid-template-columns: 1fr; }
}
