import {
  getThreeGateReceipt,
  runThreeGateAssessment,
} from "./incident_three_gate_service.ts";
import type { ThreeGateBegin } from "./incident_three_gate_service.ts";
import type { FullFifo } from "./incident_full_fifo.ts";
import type { ExpertModelResult } from "./incident_expert.ts";
import { HttpError } from "./http.ts";
const assessment = "11111111-1111-4111-8111-111111111111";
const incident = "22222222-2222-4222-8222-222222222222";
const parent = "33333333-3333-4333-8333-333333333333";
const metadata: FullFifo = {
  contract_version: "THREE_GATE_FULL_FIFO_V1",
  case_id: "44444444-4444-4444-8444-444444444444",
  assessment_id: assessment,
  assessment_seq: 1,
  previous_assessment_id: null,
  origin_evidence_available: false,
  snapshot: {
    conversation_revision: 1,
    cutoff_at_ms: 2000,
    message_count: 1,
    ordered_segment_refs: ["A".repeat(22)],
    message_revisions: [1],
    pending_count: 0,
    coverage_gap: false,
    earliest_evidence_at_ms: 1000,
    latest_evidence_at_ms: 1000,
  },
  gate_evidence: {
    rule_version: "test-v1",
    evaluated_gates: [1, 2, 3],
    reason_codes: [],
  },
  digest_algorithm: "HMAC_SHA256_JSON_BINARY_V1",
  digest_key_b64: btoa("a".repeat(32)),
  payload_digest: "a".repeat(64),
};
const modelResult: ExpertModelResult = {
  modelVersion: "gpt-5.6-luna",
  analysis: {
    outcome: "inconclusive",
    primary_category: null,
    secondary_categories: [],
    severity: null,
    urgency: "routine",
    child_role: "unknown",
    pattern: "unknown",
    confidence: 0.4,
    evidence_segment_refs: ["A".repeat(22)],
  },
};
const begin: ThreeGateBegin = {
  incident_id: incident,
  created: true,
  analysis_state: "leased",
  lease_token: "a".repeat(64),
};
function equal(a: unknown, b: unknown) {
  if (JSON.stringify(a) !== JSON.stringify(b)) {
    throw new Error("Unexpected service result");
  }
}
const forbidden = async (): Promise<never> => {
  throw new Error("Replay invoked work");
};

Deno.test("completed inconclusive replay never invokes provider or finalizer", async () => {
  const result = await runThreeGateAssessment(
    {
      ...begin,
      analysis_state: "completed",
      lease_token: null,
      analysis_outcome: "inconclusive",
      delivery_count: 0,
    },
    metadata,
    { analyze: forbidden, finalize: forbidden },
  );
  equal(result.incident_id, incident);
  equal(result.created, false);
  equal(result.parent_alert_created, false);
  equal(result.expert_outcome, "inconclusive");
  equal(result.assessment_id, assessment);
  equal(result.assessment_seq, 1);
});
Deno.test("inconclusive provider result durably finalizes rather than throwing retry", async () => {
  let calls = 0;
  let saves = 0;
  const result = await runThreeGateAssessment(begin, metadata, {
    analyze: async () => {
      calls++;
      return modelResult;
    },
    finalize: async (value) => {
      saves++;
      equal(value, modelResult);
      return { analysis_outcome: "inconclusive", delivery_count: 0 };
    },
  });
  equal(calls, 1);
  equal(saves, 1);
  equal(result.expert_outcome, "inconclusive");
  equal(result.incident_id, incident);
});
Deno.test("linked completed assessment returns stable parent identity and saved delivery result", async () => {
  const result = await runThreeGateAssessment(
    {
      ...begin,
      analysis_state: "completed",
      analysis_outcome: "confirmed",
      parent_incident_id: parent,
      delivery_count: 2,
    },
    metadata,
    { analyze: forbidden, finalize: forbidden },
  );
  equal(result.incident_id, parent);
  equal(result.parent_alert_created, true);
  equal(result.created, false);
});
Deno.test("busy lease performs no expert work", async () => {
  try {
    await runThreeGateAssessment(
      { ...begin, analysis_state: "busy" },
      metadata,
      { analyze: forbidden, finalize: forbidden },
    );
  } catch (error) {
    if (error instanceof HttpError && error.status === 425) return;
    throw error;
  }
  throw new Error("Busy lease admitted");
});
Deno.test("provider transport failure never creates a semantic completion", async () => {
  let saved = false;
  try {
    await runThreeGateAssessment(begin, metadata, {
      analyze: async () => {
        throw new Error("synthetic_transport_failure");
      },
      finalize: async () => {
        saved = true;
        return { analysis_outcome: "dismissed", delivery_count: 0 };
      },
    });
  } catch (error) {
    equal(saved, false);
    if (
      error instanceof Error && error.message === "synthetic_transport_failure"
    ) return;
    throw error;
  }
  throw new Error("Transport failure swallowed");
});
Deno.test("invalid completed outcome cannot become a successful acknowledgement", async () => {
  try {
    await runThreeGateAssessment(
      { ...begin, analysis_state: "completed", analysis_outcome: "safe" },
      metadata,
      { analyze: forbidden, finalize: forbidden },
    );
  } catch (error) {
    if (
      error instanceof Error &&
      error.message === "invalid_three_gate_completion"
    ) return;
    throw error;
  }
  throw new Error("Invalid terminal outcome acknowledged");
});

const receiptQuery = {
  operation: "get_assessment_receipt",
  case_id: metadata.case_id,
  assessment_id: assessment,
  assessment_seq: 1,
};
Deno.test("receipt-only completed lookup preserves original result without provider configuration", async () => {
  let lookups = 0;
  const receipt = await getThreeGateReceipt(
    receiptQuery,
    async (caseId, assessmentId, sequence) => {
      lookups++;
      equal([caseId, assessmentId, sequence], [
        metadata.case_id,
        assessment,
        1,
      ]);
      return {
        receipt_state: "completed",
        incident_id: incident,
        created: false,
        analysis_outcome: "inconclusive",
        expert_outcome: "inconclusive",
        case_id: caseId,
        assessment_id: assessmentId,
        assessment_seq: sequence,
        message_count: 1,
        payload_digest: metadata.payload_digest,
        parent_alert_created: false,
      };
    },
  );
  equal(lookups, 1);
  equal(receipt.expert_outcome, "inconclusive");
  equal(receipt.incident_id, incident);
});
Deno.test("pending and not_found receipt observations never report safe or a completion", async () => {
  for (const state of ["pending", "not_found"]) {
    const receipt = await getThreeGateReceipt(
      receiptQuery,
      async () => ({
        receipt_state: state,
        expert_outcome: "dismissed",
        encrypted_payload_base64: "must_not_escape",
      }),
    );
    equal(Object.keys(receipt).sort(), [
      "assessment_id",
      "assessment_seq",
      "case_id",
      "receipt_state",
    ]);
    equal(receipt.receipt_state, state);
  }
});
Deno.test("receipt-only mode refuses ciphertext and malformed identity before lookup", async () => {
  for (
    const body of [{ ...receiptQuery, encrypted_payload_base64: "forbidden" }, {
      ...receiptQuery,
      assessment_id: "not-a-uuid",
    }, { ...receiptQuery, assessment_seq: 0 }]
  ) {
    try {
      await getThreeGateReceipt(body, forbidden);
    } catch (error) {
      if (error instanceof HttpError && error.status === 400) continue;
      throw error;
    }
    throw new Error("Invalid receipt query accepted");
  }
});
