import { expect, test } from "../playwright-fixture";

test("parent moments support touch and keyboard navigation in RTL", async ({ page }) => {
  await page.goto("/");
  const first = page.getByRole("tab", { name: "משהו עובר עליו?" });
  const second = page.getByRole("tab", { name: "איך מתחילים לדבר?" });
  const last = page.getByRole("tab", { name: "הוא כבר הגיע?" });
  const panel = page.getByRole("tabpanel");
  await first.focus();
  await page.keyboard.press("ArrowLeft");
  await expect(second).toBeFocused();
  await expect(second).toHaveAttribute("aria-selected", "true");
  await expect(panel).toHaveAccessibleName("איך מתחילים לדבר?");
  await expect(panel.getByRole("heading")).toHaveText("למצוא את המילים הנכונות.");
  await page.keyboard.press("End");
  await expect(last).toBeFocused();
  await page.keyboard.press("ArrowLeft");
  await expect(first).toBeFocused();
  await last.click();
  await expect(panel.getByRole("heading")).toHaveText("קצת פחות לנחש.");
  await expect(panel).toContainText("המחשת הרעיון. Kippy בפיתוח לקראת השקה.");
  await expect(page.locator('[role="tab"][tabindex="0"]')).toHaveCount(1);
});

for (const width of [320, 390, 768, 1440]) {
  test(`brand layout and local font at ${width}px`, async ({ page }, testInfo) => {
    await page.setViewportSize({ width, height: 900 });
    await page.emulateMedia({ reducedMotion: "reduce" });
    const errors: string[] = [];
    page.on("pageerror", error => errors.push(error.message));
    await page.goto("/");
    await expect(page.getByRole("heading", { level: 1 })).toBeVisible();
    await page.evaluate(() => document.fonts.ready);
    expect(await page.evaluate(() => document.fonts.check('400 18px Fredoka', 'שלום הורים'))).toBe(true);
    for (const section of await page.locator("main section").all()) {
      await section.scrollIntoViewIfNeeded();
      expect(await page.evaluate(() => document.documentElement.scrollWidth <= document.documentElement.clientWidth + 1)).toBe(true);
    }
    for (const tab of await page.getByRole("tab").all()) {
      const rect = await tab.boundingBox();
      expect(rect?.height).toBeGreaterThanOrEqual(44);
      expect(rect?.width).toBeGreaterThanOrEqual(44);
    }
    await page.getByRole("link", { name: "בחזרה למעלה" }).click();
    await testInfo.attach(`brand-${width}`, { body: await page.screenshot({ fullPage: true }), contentType: "image/png" });
    await page.getByRole("button", { name: "מצטרפים לעדכונים", exact: true }).first().click();
    const dialog = page.getByRole("dialog");
    await expect(dialog).toBeVisible();
    const rect = await dialog.boundingBox();
    expect(rect?.x).toBeGreaterThanOrEqual(0);
    expect((rect?.x ?? 0) + (rect?.width ?? 0)).toBeLessThanOrEqual(width + 1);
    await page.keyboard.press("Escape");
    await expect(dialog).not.toBeVisible();
    expect(errors).toEqual([]);
  });
}

test("waitlist preserves input after a failed request and permits one retry", async ({ page }) => {
  let attempts = 0;
  await page.route("**/rest/v1/rpc/v2_submit_marketing_waitlist", async route => {
    attempts++;
    await route.fulfill(attempts === 1 ? {
      status: 500, contentType: "application/json", body: JSON.stringify({ message: "Synthetic test failure" }),
    } : {
      status: 200, contentType: "application/json", body: JSON.stringify("11111111-1111-4111-8111-111111111111"),
    });
  });
  await page.goto("/");
  await page.getByRole("button", { name: "מצטרפים לעדכונים", exact: true }).first().click();
  const dialog = page.getByRole("dialog");
  await dialog.getByLabel(/^שם ההורה/).fill("הורה לבדיקה");
  await dialog.getByLabel(/^אימייל/).fill("brand-retry@example.com");
  await dialog.getByLabel(/^מספר טלפון/).fill("0501234567");
  await dialog.getByLabel(/^גיל הילד/).fill("11");
  await dialog.getByRole("button", { name: "Android" }).click();
  const submit = dialog.getByRole("button", { name: "מצטרפים לעדכונים", exact: true });
  await submit.click();
  await expect(dialog.getByRole("alert")).toContainText("אירעה שגיאה");
  await expect(dialog.getByLabel(/^אימייל/)).toHaveValue("brand-retry@example.com");
  await expect(submit).toBeEnabled();
  await submit.click();
  await expect(dialog.getByRole("heading", { name: "נרשמת בהצלחה" })).toBeVisible();
  expect(attempts).toBe(2);
});

test("large text and high contrast keep the mobile landing usable", async ({ page }, testInfo) => {
  await page.setViewportSize({ width: 320, height: 900 });
  await page.goto("/");
  const description = page.locator(".kippy-hero-description");
  const initialSize = await description.evaluate(el => parseFloat(getComputedStyle(el).fontSize));
  await page.getByRole("button", { name: "הגדרות נגישות", exact: true }).click();
  const panel = page.getByRole("dialog", { name: "הגדרות נגישות" });
  for (let i = 0; i < 4; i++) await panel.getByRole("button", { name: "הגדל טקסט" }).click();
  await panel.getByRole("switch", { name: "ניגודיות גבוהה", exact: true }).click();
  await panel.getByRole("button", { name: "סגור הגדרות נגישות" }).click();
  const largeSize = await description.evaluate(el => parseFloat(getComputedStyle(el).fontSize));
  expect(largeSize / initialSize).toBeGreaterThan(1.35);
  await expect(page.locator(".kippy-site")).toHaveCSS("background-color", "rgb(0, 0, 0)");
  await expect(description).toHaveCSS("color", "rgb(255, 255, 255)");
  for (const width of [320, 768]) {
    await page.setViewportSize({ width, height: 900 });
    expect(await page.evaluate(() => document.documentElement.scrollWidth <= document.documentElement.clientWidth + 1)).toBe(true);
    for (const el of await page.locator(".kippy-nav-logo, .kippy-nav .kippy-button, .kippy-hero h1, .kippy-moment-tabs button").all()) {
      const rect = await el.boundingBox();
      expect(rect?.x).toBeGreaterThanOrEqual(0);
      expect((rect?.x ?? 0) + (rect?.width ?? 0)).toBeLessThanOrEqual(width + 1);
      expect(await el.evaluate(node => node.scrollWidth <= node.clientWidth + 1)).toBe(true);
    }
  }
  await testInfo.attach("brand-large-text-high-contrast", { body: await page.screenshot(), contentType: "image/png" });
});
